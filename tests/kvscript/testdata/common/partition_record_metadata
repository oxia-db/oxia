# Compare metadata by relation rather than numeric IDs or wall-clock ordering.
# Put snapshots contain its returned Version, without an extra Get.

put key=record value="" save=created-version save-record=created partition=route
----
ok key="record" modifications=0

assert-record key=record unchanged=@created persistent partition=route
----
ok

get key=record include-value=false persistent save-record=created-metadata partition=route
----
key="record" value="" modifications=0

assert-record key=record metadata=@created-metadata persistent partition=route
----
ok

# A same-value write is still an update, including when the value is empty.
put key=record value="" expected-version=@created-version save=updated-version save-record=updated partition=route
----
ok key="record" modifications=1

assert-record key=record updated=@created persistent partition=route
----
ok

assert-record key=record unchanged=@updated persistent partition=route
----
ok

put key=record value="\x00\xffpayload" expected-version=@updated-version save=latest-version save-record=latest partition=route
----
ok key="record" modifications=2

assert-record key=record updated=@updated persistent partition=route
----
ok

assert-record key=record unchanged=@latest persistent partition=route
----
ok

get key=record include-value=false persistent save-record=latest-metadata partition=route
----
key="record" value="" modifications=2

assert-record key=record metadata=@latest-metadata persistent partition=route
----
ok

# Failed writes must not overwrite saved records or versions either.
put key=record value="rejected" expected-version=@updated-version save=latest-version save-record=latest partition=route
----
error: unexpected version id

assert-record key=record unchanged=@latest persistent partition=route
----
ok

delete key=record expected-version=@created-version partition=route
----
error: unexpected version id

assert-record key=record unchanged=@latest persistent partition=route
----
ok

delete key=record expected-version=@latest-version partition=route
----
ok

get key=record include-value=false persistent partition=route
----
error: key not found

put key=record value="reborn" create-only save=reborn-version save-record=reborn partition=route
----
ok key="record" modifications=0

assert-record key=record unchanged=@reborn persistent partition=route
----
ok

put key=record value="stale" expected-version=@latest-version partition=route
----
error: unexpected version id

delete key=record expected-version=@latest-version partition=route
----
error: unexpected version id

assert-record key=record unchanged=@reborn persistent partition=route
----
ok

get key=record include-value=true persistent partition=route
----
key="record" value="reborn" modifications=0
