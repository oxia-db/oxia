# Distinct SDK clients observe committed records and can exchange CAS versions.

put key=a value="from-a" create-only save=initial save-record=initial-record
----
ok key="a" modifications=0

client name=observer
----
ok

assert-record key=a unchanged=@initial-record persistent
----
ok

get key=a save=observed
----
key="a" value="from-a" modifications=0

put key=a value="from-b" expected-version=@observed save=updated save-record=updated-record
----
ok key="a" modifications=1

assert-record key=a updated=@initial-record persistent
----
ok

use-client name=default
----
ok

assert-record key=a unchanged=@updated-record persistent
----
ok

put key=a value="stale-a" expected-version=@initial
----
error: unexpected version id

assert-record key=a unchanged=@updated-record persistent
----
ok

put key=b value="second" create-only save-record=second
----
ok key="b" modifications=0

use-client name=observer
----
ok

list start=a end=c unordered
----
key="a"
key="b"

range start=a end=c unordered
----
key="a" value="from-b" modifications=1
key="b" value="second" modifications=0

delete key=a expected-version=@updated
----
ok

use-client name=default
----
ok

assert-record key=a missing
----
ok

put key=a value="reborn-a" create-only save=reborn save-record=reborn-record
----
ok key="a" modifications=0

use-client name=observer
----
ok

delete key=a expected-version=@updated
----
error: unexpected version id

assert-record key=a unchanged=@reborn-record persistent
----
ok

put key=a value="last-b" expected-version=@reborn save=last save-record=last-record
----
ok key="a" modifications=1

assert-record key=a updated=@reborn-record persistent
----
ok

use-client name=default
----
ok

assert-record key=a unchanged=@last-record persistent
----
ok

delete key=a expected-version=@last
----
ok

use-client name=observer
----
ok

get key=a include-value=false persistent
----
error: key not found

# Range deletion by B is also visible to A.
delete-range start=a end=c
----
ok

use-client name=default
----
ok

assert-record key=b missing
----
ok

list start=a end=c unordered
----
(empty)

range start=a end=c unordered
----
(empty)
